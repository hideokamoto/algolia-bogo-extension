# Files left out of the release zip and of WordPress.org trunk/ and tags/.
# The release pipeline (hideokamoto/circleci-configurations
# workflows/release/wordpress-plugin-github-release.yaml) builds the zip with
# `git archive`, which skips paths marked export-ignore.
# Based on .distignore, plus the development files it did not list.
/.chunk export-ignore
/.cursor export-ignore
/.github export-ignore
/.circleci export-ignore
/.distignore export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.phpcs.xml.dist export-ignore
/.wp-env.json export-ignore
/.wordpress-org export-ignore
/README.md export-ignore
/blueprint.json export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpunit.xml.dist export-ignore
/scripts export-ignore
/tests export-ignore
/wp-now.json export-ignore
/vendor export-ignore
/node_modules export-ignore
